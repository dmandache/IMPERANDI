{
  "dataset_name": "generic",
  "id_extraction": {
    "source": "auto",
    "force_dicom_read": false,
    "patient_key": { "from_tag": "PatientName", "fallback": "path" },
    "study_id":    { "from_tag": "StudyInstanceUID", "fallback": "path" },
    "series_id":   { "from_tag": "SeriesInstanceUID", "fallback": "path" }
  },
  "id_standardization": {
    "hook_module": "datasets_config.hooks.generic",
    "function": "standardize_patient_key"
  },
  "segmentation": {
    "backend": "totalsegmentator",
    "tasks": [
      {
        "task": "total",
        "extra": { "roi_subset": ["liver", "pancreas"], "fast": true }
      },
      {
        "task": "liver_vessels",
        "extra": {"fast": false }
      }
    ],
    "postprocess": [
      {
        "merge_keys": ["liver", "liver_tumor"],
        "out_key": "liver_proc",
        "radius_mm": 5.0,
        "largest_cc": true,
        "fill_holes": true,
        "close": true
      },
      {
        "in_key": "pancreas",
        "out_key": "pancreas",
        "radius_mm": 5.0,
        "close": true
      }
    ]
  }
}

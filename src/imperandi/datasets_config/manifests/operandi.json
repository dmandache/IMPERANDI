{
  "dataset_name": "operandi",
  "id_extraction": {
    "source": "auto",
    "force_dicom_read": false,
    "patient_key": { "from_tag": "PatientName", "fallback": "path" },
    "study_id": { "from_tag": "StudyInstanceUID", "fallback": "path" },
    "series_id": { "from_tag": "SeriesInstanceUID", "fallback": "path" }
  },
  "id_standardization": {
    "hook_module": "datasets_config.hooks.operandi",
    "function": "standardize_operandi_patient_key"
  },
  "derived_columns": [
    {
      "hook_module": "datasets_config.hooks.operandi",
      "function": "extract_from_patient_key",
      "from_column": "patient_key",
      "join_mode": "missing_only"
    }
  ],
  "cleaning": {
    "version": 1,
    "steps": [
      {
        "type": "hook",
        "function": "datasets_config.hooks.operandi:standardize_operandi_patient_key",
        "source_columns": ["patient_key"]
      },
      {
        "type": "hook",
        "function": "datasets_config.hooks.operandi:extract_from_patient_key",
        "source_columns": ["patient_key"]
      },
      { "type": "coalesce_date" },
      { "type": "coalesce_time" },
      { "type": "sop_class" },
      { "type": "parse_image_type" },
      { "type": "clean_scan_size" },
      {
        "type": "filter",
        "kind": "keep",
        "scope": "row",
        "logic": "and",
        "rules": [
          { "column": "Modality", "op": "eq", "value": "CT" },
          { "column": "sop_class", "op": "eq", "value": "CTImageStorage" }
        ]
      },
      {
        "type": "filter",
        "kind": "discard",
        "scope": "row",
        "logic": "or",
        "rules": [
          { "column": "ModalitiesInStudy", "op": "contains", "value": "PT" },
          { "column": "ModalitiesInStudy", "op": "contains", "value": "NM" }
        ]
      },
      {
        "type": "filter",
        "kind": "discard",
        "scope": "row",
        "logic": "or",
        "rules": [
          { "column": "ImageType", "op": "contains", "value": "LOCALIZER" },
          { "column": "SeriesDescription", "op": "icontains", "value": "scout" }
        ]
      },
      { "type": "normalize_string", "column": "SeriesDescription" },
      {
        "type": "filter",
        "kind": "discard",
        "scope": "row",
        "logic": "or",
        "rules": [
          { "column": "SeriesDescription", "op": "contains", "value": "pelvis" },
          { "column": "SeriesDescription", "op": "contains", "value": "crane" },
          { "column": "SeriesDescription", "op": "contains", "value": "rachis" },
          { "column": "SeriesDescription", "op": "contains", "value": "prostate" },
          { "column": "SeriesDescription", "op": "contains", "value": "phlebo" },
          { "column": "SeriesDescription", "op": "contains", "value": "meckel" },
          { "column": "SeriesDescription", "op": "contains", "value": "femur" },
          { "column": "SeriesDescription", "op": "contains", "value": "orl" }
        ]
      },
      { "type": "pixel_spacing_xy" },
      {
        "type": "filter",
        "kind": "keep",
        "scope": "row",
        "logic": "and",
        "keep_null": true,
        "rules": [
          { "column": "PixelSpacingXY", "op": "lte", "value": 1.25 }
        ]
      },
      { "type": "standardize_iop" },
      { "type": "classify_acquisition_plane" },
      {
        "type": "filter",
        "kind": "keep",
        "scope": "row",
        "logic": "and",
        "rules": [
          { "column": "acquisition_axis", "op": "eq", "value": "Z" }
        ]
      },
      {
        "type": "build_volume_id",
        "preferred_columns": [
          "patient_key",
          "study_id",
          "series_id",
          "ImageType",
          "AcquisitionNumber",
          "ImageOrientationPatient",
          "SliceThickness",
          "PixelSpacingXY"
        ],
        "fallback_columns": ["patient_key", "study_id", "series_id"]
      },
      {
        "type": "merge_volume_ids",
        "group_columns": [
          "patient_key",
          "study_id",
          "series_id",
          "ImageType",
          "ImageOrientationPatient",
          "SliceThickness",
          "PixelSpacingXY"
        ],
        "z_sources": ["ImagePositionPatient", "SliceLocation"],
        "z_tolerance": 0.001
      },
      { "type": "group_volumes" },
      { "type": "compute_volume_length" },
      {
        "type": "filter",
        "kind": "keep",
        "scope": "volume",
        "logic": "and",
        "keep_null": true,
        "rules": [
          { "column": "volume_length", "op": "gte", "value": 30.0 },
          { "column": "volume_length", "op": "lte", "value": 1700.0 }
        ]
      },
      { "type": "compute_visit_order" },
      { "type": "compute_acquisition_order" },
      { "type": "finalize" }
    ]
  },
  "segmentation": {
    "backend": "totalsegmentator",
    "tasks": [
      {
        "task": "total",
        "extra": { "roi_subset_robust": ["liver"] }
      },
      {
        "task": "liver_lesions",
        "output": "liver_tumor",
        "fetch_output": "liver_lesions"
      }
    ],
    "postprocess": {
      "merge_keys": ["liver", "liver_tumor"],
      "output": "liver",
      "radius_mm": 5.0,
      "largest_cc": true,
      "fill_holes": true,
      "close": true
    }
  },
  "radiomics": {
    "pyradiomics": {
      "setting": {
        "binWidth": 25,
        "resampledPixelSpacing": [1, 1, 1],
        "resegmentRange": [-150, 250],
        "correctMask": true
      },
      "imageType": {
        "Original": {}
      }
    },
    "filters": {
      "phase": ["arteriel", "portal"]
    }
  }
}
